# ==============================================================================
# ProjectMatch — Environment Variables Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit your actual .env file or production credentials to Git.
# ==============================================================================

# Database Configuration (MySQL)
DB_NAME=projectmatch
DB_USER=projectmatch
DB_PASSWORD=replace_with_secure_database_password
DB_ROOT_PASSWORD=replace_with_secure_root_password
DB_PORT=3306

# Backend Configuration
BACKEND_PORT=8080
SERVER_PORT=8080

# Security Configuration
# JWT Secret MUST be at least 256 bits (32+ random characters) for HMAC-SHA256
JWT_SECRET=ReplaceWithAStrongSecretKeyOfAtLeast32RandomCharactersForProduction2026
JWT_EXPIRATION_MS=86400000

# Initial Administrator Credentials (provisioned on first startup if user does not exist)
ADMIN_EMAIL=admin@projectmatch.edu
ADMIN_PASSWORD=change_this_admin_password_for_production

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Frontend Configuration
FRONTEND_PORT=3000

# Optional: AI Assistant Integration (Google Gemini API key)
# Leave empty to use deterministic built-in fallback suggestions
AI_API_KEY=

# Optional: Frontend API URL Override (leave empty to use Nginx reverse proxy)
VITE_API_URL=
